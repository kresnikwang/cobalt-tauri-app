{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobalt",
  "version": "1.0.8",
  "identifier": "com.kresnikwang.cobalt",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Cobalt",
        "width": 700,
        "height": 780,
        "minWidth": 520,
        "minHeight": 600,
        "transparent": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "binaries/yt-dlp": "binaries/yt-dlp",
      "binaries/node": "binaries/node",
      "binaries/ffmpeg": "binaries/ffmpeg",
      "binaries/res-sniffer": "binaries/res-sniffer",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../third_party/res-downloader/UPSTREAM.md": "licenses/res-downloader/UPSTREAM.md",
      "../third_party/wx_channels_download/LICENSE": "licenses/wx_channels_download/LICENSE",
      "../third_party/wx_channels_download/UPSTREAM.md": "licenses/wx_channels_download/UPSTREAM.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
